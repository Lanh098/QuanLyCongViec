<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="CHI TIẾT CÔNG VIỆC"
            android:textSize="24sp"
            android:textStyle="bold"
            android:paddingBottom="20dp" />

        <TextView
            android:id="@+id/tvThongTinChiTiet"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Thông tin công việc"
            android:textSize="18sp"
            android:padding="12dp"
            android:background="#F1F3F4"
            android:lineSpacingExtra="6dp" />

        <Button
            android:id="@+id/btnTrangThai"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Đánh dấu hoàn thành"
            android:layout_marginTop="20dp" />

        <Button
            android:id="@+id/btnSuaCongViec"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Chỉnh sửa"
            android:layout_marginTop="8dp" />

        <Button
            android:id="@+id/btnQuayLai"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Quay lại màn hình chính"
            android:layout_marginTop="8dp" />

    </LinearLayout>

</ScrollView>
